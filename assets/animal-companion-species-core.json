    "url": "https://legacy.aonprd.com/coreRulebook/classes/druid.html#animal-choices"
  },
  "applicationOrder": [
    "Load species starting statistics",
    "Apply the cumulative row from animal-companion-progression.json for effective companion level",
    "At the species milestone, apply either the listed species advancement package or the alternative +2 Dexterity/+2 Constitution package, never both",
    "Apply the player's chosen +1 ability-score increases from universal progression",
    "Apply feats, equipment, spells, conditions, and other active effects"
  ],
  "rules": {
    "universalProgressionFile": "animal-companion-progression.json",
    "advancementChoice": {
      "listed": "Apply every field in the species advancement package, including any size, natural armor, attacks, ability adjustments, and new abilities.",
      "alternative": {"dex": 2, "con": 2, "insteadOfListedAdvancement": true},
      "default": "listed",
      "requiresPlayerChoice": true
    },
    "naturalArmor": "startingNaturalArmor is the species' initial natural armor bonus. Species advancement naturalArmorAdjustment and universal progression naturalArmorAdjustment are both added when applicable.",
    "abilityScores": "Starting scores are actual companion scores, not Wild Shape polymorph adjustments. Species advancement adjustments and universal Str/Dex adjustments are cumulative additions.",
    "damageMultipliers": "An only natural weapon adds 1.5 times Strength to damage. Primary attacks in a multiattack routine add 1 times Strength; secondary attacks add 0.5 times Strength.",
    "attackChoiceGroups": "Attacks sharing a non-null choiceGroup are alternatives and are not made together in one routine.",
    "noWildShapeNumericReuse": true
  },
