{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "find-your-class/questions.schema.json",
  "title": "Find Your Class adaptive question templates",
  "type": "object",
  "required": ["schemaVersion", "questions"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt", "answers"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "criteriaClarified": { "type": "array", "items": { "type": "string" } },
          "allowNotRelevant": { "type": "boolean" },
          "estimatedCognitiveCost": { "type": "number" },
          "priority": { "type": "number" },
          "multiSelect": { "type": "boolean" },
          "notes": { "type": "array", "items": { "type": "string" } },
          "answers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "mutations"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "mutations": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
