{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "find-your-class/catalogue.schema.json",
  "title": "Find Your Class catalogue entity (class, archetype, optionFamily or option)",
  "type": "object",
  "required": ["id", "entityType", "name", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "entityType": { "type": "string", "enum": ["class", "archetype", "optionFamily", "option"] },
    "name": { "type": "string", "minLength": 1 },
    "parentId": { "type": ["string", "null"] },
    "optionFamilyId": { "type": "string" },
    "parentClassId": { "type": "string" },
    "sourceCategory": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft", "needs-review", "reviewed", "disputed", "deprecated"] },
    "identity": {
      "type": "object",
      "properties": {
        "fantasyTags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "strength"],
            "properties": { "id": { "type": "string" }, "strength": { "type": "number", "minimum": 1, "maximum": 10 } }
          }
        },
        "oneLineFantasy": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rating": { "type": "number", "minimum": 1, "maximum": 10 },
          "position": { "type": "number", "minimum": 1, "maximum": 10 },
          "confidence": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        },
        "not": { "required": ["rating", "position"] }
      }
    },
    "categories": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "progression": {
      "type": "object",
      "properties": {
        "conceptOnline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conceptTag", "level"],
            "properties": { "conceptTag": { "type": "string" }, "level": { "type": "integer", "minimum": 1, "maximum": 20 } }
          }
        },
        "bands": {
          "type": "object",
          "properties": { "low": { "type": "number" }, "mid": { "type": "number" }, "high": { "type": "number" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "ability": { "type": "string" },
          "severity": { "type": "string", "enum": ["mild", "moderate", "strong"] },
          "note": { "type": "string" }
        }
      }
    },
    "rulesRestrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "operator", "value", "sourceRef"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "operator": { "type": "string" },
          "value": {},
          "sourceRef": { "type": "string" }
        }
      }
    },
    "links": { "type": "object", "additionalProperties": { "type": "string" } },
    "explanationProfile": {
      "type": "object",
      "properties": {
        "experienceTemplateId": { "type": "string" },
        "strengthFragmentIds": { "type": "array", "items": { "type": "string" } },
        "tradeoffFragmentIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": { "op": { "type": "string" } }
      }
    },
    "archetypeSummary": { "type": "string" },
    "compatibility": {
      "type": "object",
      "properties": {
        "incompatibleArchetypeIds": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendationValue": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "entityType": { "const": "archetype" } } },
      "then": { "required": ["parentId", "operations"] }
    },
    {
      "if": { "properties": { "entityType": { "const": "option" } } },
      "then": { "required": ["optionFamilyId", "parentClassId", "operations"] }
    }
  ]
}
